{
  "Comment": "A state machine for producing estimates by job role",
  "StartAt": "Estimates by job role",
  "States": {
    "Estimates by job role": {
      "Type": "Parallel",
      "Branches": [
        {
          "StartAt": "Archive Job Role Estimates",
          "States": {
            "Archive Job Role Estimates": {
              "Type": "Task",
              "Resource": "arn:aws:states:::ecs:runTask.sync",
              "Parameters": {
                "Cluster": "${polars_cluster_arn}",
                "TaskDefinition": "${independent_cqc_task_arn}",
                "LaunchType": "FARGATE",
                "NetworkConfiguration": {
                  "AwsvpcConfiguration": {
                    "Subnets": ${public_subnet_ids},
                    "SecurityGroups": ["${independent_cqc_security_group_id}"],
                    "AssignPublicIp": "ENABLED"
                  }
                },
                "Overrides": {
                  "ContainerOverrides": [
                    {
                      "Name": "_03_independent_cqc-container",
                      "Command": [
                        "archive_job_role_estimates.py",
                        "--job_role_estimates_source", "${dataset_bucket_uri}/domain=03_ind_cqc/dataset=01_filled_posts_06_job_roles_04_estimate/",
                        "--job_role_metadata_source", "${dataset_bucket_uri}/domain=03_ind_cqc/dataset=01_filled_posts_06_job_roles_01_merge_metadata/",
                        "--job_role_estimates_destination", "${dataset_bucket_uri}/domain=03_ind_cqc/dataset=01_filled_posts_08_archived_job_role_estimates/",
                        "--job_role_metadata_destination", "${dataset_bucket_uri}/domain=03_ind_cqc/dataset=01_filled_posts_08_archived_job_role_estimates_metadata/"
                      ]
                    }
                  ]
                }
              },
              "Next": "Validate Job Role Archive"
            },
            "Validate Job Role Archive": {
              "Type": "Parallel",
              "Branches": [
                {
                  "StartAt": "Validate Job Role Estimates Archive",
                  "States": {
                    "Validate Job Role Estimates Archive": {
                      "Type": "Task",
                      "Resource": "arn:aws:states:::ecs:runTask.sync",
                      "Parameters": {
                        "Cluster": "${polars_cluster_arn}",
                        "TaskDefinition": "${independent_cqc_task_arn}",
                        "LaunchType": "FARGATE",
                        "NetworkConfiguration": {
                          "AwsvpcConfiguration": {
                            "Subnets": ${public_subnet_ids},
                            "SecurityGroups": ["${independent_cqc_security_group_id}"],
                            "AssignPublicIp": "ENABLED"
                          }
                        },
                        "Overrides": {
                          "ContainerOverrides": [
                            {
                              "Name": "_03_independent_cqc-container",
                              "Command": [
                                "validate_archive_job_role_estimates.py",
                                "--bucket_name", "${dataset_bucket_name}",
                                "--dataset", "estimates",
                                "--source_path", "domain=03_ind_cqc/dataset=01_filled_posts_08_archived_job_role_estimates/",
                                "--compare_path", "domain=03_ind_cqc/dataset=main_01_filled_posts_06_job_roles_04_estimate/",
                                "--other_output_path", "domain=03_ind_cqc/dataset=01_filled_posts_08_archived_job_role_estimates_metadata/",
                                "--reports_path", "domain=03_ind_cqc/dataset=01_filled_posts_08_archived_job_role_estimates_validation/"
                              ]
                            }
                          ]
                        }
                      },
                      "End": true
                    }
                  }
                },
                {
                  "StartAt": "Validate Job Role Metadata Archive",
                  "States": {
                    "Validate Job Role Metadata Archive": {
                      "Type": "Task",
                      "Resource": "arn:aws:states:::ecs:runTask.sync",
                      "Parameters": {
                        "Cluster": "${polars_cluster_arn}",
                        "TaskDefinition": "${independent_cqc_task_arn}",
                        "LaunchType": "FARGATE",
                        "NetworkConfiguration": {
                          "AwsvpcConfiguration": {
                            "Subnets": ${public_subnet_ids},
                            "SecurityGroups": ["${independent_cqc_security_group_id}"],
                            "AssignPublicIp": "ENABLED"
                          }
                        },
                        "Overrides": {
                          "ContainerOverrides": [
                            {
                              "Name": "_03_independent_cqc-container",
                              "Command": [
                                "validate_archive_job_role_estimates.py",
                                "--bucket_name", "${dataset_bucket_name}",
                                "--dataset", "metadata",
                                "--source_path", "domain=03_ind_cqc/dataset=01_filled_posts_08_archived_job_role_estimates_metadata/",
                                "--compare_path", "domain=03_ind_cqc/dataset=main_01_filled_posts_06_job_roles_01_merge_metadata/",
                                "--other_output_path", "domain=03_ind_cqc/dataset=01_filled_posts_08_archived_job_role_estimates/",
                                "--reports_path", "domain=03_ind_cqc/dataset=01_filled_posts_08_archived_job_role_estimates_metadata_validation/"
                              ]
                            }
                          ]
                        }
                      },
                      "End": true
                    }
                  }
                }
              ],
              "End": true
            }
          }
        }
      ],
      "Next": "Handle Error and Run Crawlers",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "Handle Error and Run Crawlers",
          "ResultPath": "$.error"
        }
      ]
    },
    "Handle Error and Run Crawlers": {
      "Type": "Parallel",
      "Branches": [
        {
          "StartAt": "Check if Error Exists",
          "States": {
            "Check if Error Exists": {
              "Type": "Choice",
              "Choices": [
                {
                  "Variable": "$.error",
                  "IsPresent": true,
                  "Next": "Publish Error Notification"
                }
              ],
              "Default": "No Error"
            },
            "Publish Error Notification": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke.waitForTaskToken",
              "Parameters": {
                "FunctionName": "${pipeline_failure_lambda_function_arn}:$LATEST",
                "Payload": {
                  "Error.$": "$.error.Cause",
                  "ExecutionId.$": "$$.Execution.Id",
                  "StateMachineName.$": "$$.StateMachine.Name",
                  "StateMachineId.$": "$$.StateMachine.Id",
                  "ExecutionStartTime.$": "$$.Execution.StartTime",
                  "CallbackToken.$": "$$.Task.Token"
                }
              },
              "Next": "Fail"
            },
            "No Error": {
              "Type": "Succeed"
            },
            "Fail": {
              "Type": "Fail"
            }
          }
        },
        {
          "StartAt": "Run IND CQC Crawler",
          "States": {
            "Run IND CQC Crawler": {
              "Type": "Task",
              "Resource": "arn:aws:states:::aws-sdk:glue:startCrawler",
              "Parameters": {
                "Name": "${ind_cqc_crawler_name}"
              },
              "End": true
            }
          }
        }
      ],
      "End": true
    }
  }
}
