{
    "Comment": "A description of my state machine",
    "StartAt": "Ingest ASCWDS",
    "States": {
        "Ingest ASCWDS": {
            "Type": "Task",
            "Resource": "arn:aws:states:::ecs:runTask.sync",
            "Parameters": {
                "LaunchType": "FARGATE",
                "Cluster": "${polars_cluster_arn}",
                "TaskDefinition": "${ingest_task_arn}",
                "NetworkConfiguration": {
                    "AwsvpcConfiguration": {
                        "Subnets": ${public_subnet_ids},
                        "SecurityGroups": ["${ingest_security_group_id}"],
                        "AssignPublicIp": "ENABLED"
                    }
                },
                "Overrides": {
                    "ContainerOverrides": [
                        {
                            "Name": "_01_ingest-container",
                            "Command.$": "States.Array('ingest_ascwds_dataset.py', '--source', $.jobs.ingest_ascwds_dataset.source, '--destination_prefix', 's3://${dataset_bucket_name}/domain=ASCWDS/')"
                        }
                    ]
                }
            },
            "Catch": [
                {
                    "ErrorEquals": [
                        "States.ALL"
                    ],
                    "Next": "Publish error notification",
                    "ResultPath": "$.error"
                }
            ],
            "Next": "Run Data Engineering ASC WDS Crawler"
        },
        "Publish error notification": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke.waitForTaskToken",
            "Parameters": {
                "FunctionName": "${pipeline_failure_lambda_function_arn}:$LATEST",
                "Payload": {
                "Error.$": "$.error.Cause",
                "ExecutionId.$": "$$.Execution.Id",
                "StateMachineName.$": "$$.StateMachine.Name",
                "StateMachineId.$": "$$.StateMachine.Id",
                "ExecutionStartTime.$": "$$.Execution.StartTime",
                "CallbackToken.$": "$$.Task.Token"
                }
            },
            "Next": "Fail"
        },
        "Run Data Engineering ASC WDS Crawler": {
            "Type": "Task",
            "Resource": "arn:aws:states:::states:startExecution.sync:2",
            "Parameters": {
              "StateMachineArn": "${run_crawler_state_machine_arn}",
              "Input": {
                "crawler_name": "${ascwds_crawler_name}",
                "AWS_STEP_FUNCTIONS_STARTED_BY_EXECUTION_ID.$": "$$.Execution.Id"
              }
            },
            "Catch": [
                {
                    "ErrorEquals": [
                        "States.ALL"
                    ],
                    "Next": "Publish error notification",
                    "ResultPath": "$.error"
                }
            ],
            "Next": "Success"
        },
        "Success": {
            "Type": "Succeed"
        },
        "Fail": {
            "Type": "Fail"
        }
    }
}
