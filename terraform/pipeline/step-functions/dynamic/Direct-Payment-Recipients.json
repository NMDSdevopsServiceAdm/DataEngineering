{
  "Comment": "A description of my state machine",
  "StartAt": "Prepare direct payments",
  "States": {
    "Prepare direct payments": {
      "Type": "Task",
      "Resource": "arn:aws:states:::ecs:runTask.sync",
      "Parameters": {
        "Cluster": "${polars_cluster_arn}",
        "TaskDefinition": "${direct_payments_task_arn}",
        "LaunchType": "FARGATE",
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "Subnets": ${public_subnet_ids},
            "SecurityGroups": ["${direct_payments_security_group_id}"],
            "AssignPublicIp": "ENABLED"
          }
        },
        "Overrides": {
          "ContainerOverrides": [
            {
              "Name": "_04_direct_payments-container",
              "Command": [
                "prepare_direct_payments.py",
                "--survey_source", "${dataset_bucket_uri}/domain=04_dpr/dataset=direct_payments_survey/version=2026.02/",
                "--external_source", "${dataset_bucket_uri}/domain=04_dpr/dataset=direct_payments_external/version=2026.02/",
                "--destination", "${dataset_bucket_uri}/domain=04_dpr/dataset=direct_payments_merged/version=2026.02/"
              ]
            }
          ]
        }
      },
      "Next": "Estimate direct payments polars"
    },
    "Estimate direct payments polars": {
      "Type": "Task",
      "Resource": "arn:aws:states:::ecs:runTask.sync",
      "Parameters": {
        "Cluster": "${polars_cluster_arn}",
        "TaskDefinition": "${direct_payments_task_arn}",
        "LaunchType": "FARGATE",
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "Subnets": ${public_subnet_ids},
            "SecurityGroups": ["${direct_payments_security_group_id}"],
            "AssignPublicIp": "ENABLED"
          }
        },
        "Overrides": {
          "ContainerOverrides": [
            {
              "Name": "_04_direct_payments-container",
              "Command": [
                "estimate_direct_payments.py",
                "--direct_payments_merged_source", "${dataset_bucket_uri}/domain=04_dpr/dataset=direct_payments_merged/version=2026.02/",
                "--destination", "${dataset_bucket_uri}/domain=04_dpr/dataset=direct_payments_estimates/version=2026.02/",
                "--summary_destination", "${dataset_bucket_uri}/domain=04_dpr/dataset=direct_payments_estimates_summary/version=2026.02/"
              ]
            }
          ]
        }
      },
      "Next": "Validate estimate direct payments polars"
    },
    "Validate estimate direct payments polars": {
      "Type": "Task",
      "Resource": "arn:aws:states:::ecs:runTask.sync",
      "Parameters": {
        "Cluster": "${polars_cluster_arn}",
        "TaskDefinition": "${direct_payments_task_arn}",
        "LaunchType": "FARGATE",
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "Subnets": ${public_subnet_ids},
            "SecurityGroups": ["${direct_payments_security_group_id}"],
            "AssignPublicIp": "ENABLED"
          }
        },
        "Overrides": {
          "ContainerOverrides": [
            {
              "Name": "_04_direct_payments-container",
              "Command": [
                "validate_estimate_direct_payments.py",
                "--bucket_name", "${dataset_bucket_name}",
                "--source_path", "domain=04_dpr/dataset=direct_payments_estimates/version=2026.02/",
                "--reports_path", "domain=04_dpr/dataset=direct_payments_estimates_validation/version=2026.02/",
                "--compare_path", "domain=04_dpr/dataset=direct_payments_merged/version=2026.02/"
              ]
            }
          ]
        }
      },
      "Next": "Split pa estimates into hybrid areas"
    },
    "Split pa estimates into hybrid areas": {
      "Type": "Task",
      "Resource": "arn:aws:states:::ecs:runTask.sync",
      "Parameters": {
        "Cluster": "${polars_cluster_arn}",
        "TaskDefinition": "${direct_payments_task_arn}",
        "LaunchType": "FARGATE",
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "Subnets": ${public_subnet_ids},
            "SecurityGroups": ["${direct_payments_security_group_id}"],
            "AssignPublicIp": "ENABLED"
          }
        },
        "Overrides": {
          "ContainerOverrides": [
            {
              "Name": "_04_direct_payments-container",
              "Command": [
                "split_pa_filled_posts_into_icb_areas.py",
                "--postcode_directory_source", "${dataset_bucket_uri}/domain=01_ons/dataset=postcode_directory_cleaned/",
                "--pa_filled_posts_source", "${dataset_bucket_uri}/domain=04_dpr/dataset=direct_payments_estimates/version=2026.02/",
                "--destination", "${dataset_bucket_uri}/domain=04_dpr/dataset=direct_payments_estimates_by_icb/version=2026.02/"
              ]
            }
          ]
        }
      },
      "Next": "Run DPR crawler"
    },
    "Run DPR crawler": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:glue:startCrawler",
      "Parameters": {
        "Name": "${dpr_crawler_name}"
      },
      "End": true
    }
  }
}
