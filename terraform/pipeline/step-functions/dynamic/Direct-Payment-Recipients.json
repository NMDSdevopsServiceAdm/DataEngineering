{
  "Comment": "A state machine for producing direct payment recipient estimates and splitting them into ICB areas",
  "StartAt": "Estimate DPR",
  "States": {
    "Estimate DPR": {
      "Type": "Parallel",
      "Branches": [
        {
          "StartAt": "Merge direct payments",
          "States": {
            "Merge direct payments": {
              "Type": "Task",
              "Resource": "arn:aws:states:::ecs:runTask.sync",
              "Parameters": {
                "Cluster": "${polars_cluster_arn}",
                "TaskDefinition": "${direct_payments_task_arn}",
                "LaunchType": "FARGATE",
                "NetworkConfiguration": {
                  "AwsvpcConfiguration": {
                    "Subnets": ${public_subnet_ids},
                    "SecurityGroups": ["${direct_payments_security_group_id}"],
                    "AssignPublicIp": "ENABLED"
                  }
                },
                "Overrides": {
                  "ContainerOverrides": [
                    {
                      "Name": "_04_direct_payments-container",
                      "Command": [
                        "_01_merge.py",
                        "--survey_source", "${dataset_bucket_uri}/domain=04_dpr/dataset=00_survey/version=2027.01/",
                        "--external_source", "${dataset_bucket_uri}/domain=04_dpr/dataset=00_external/version=2027.01/",
                        "--destination", "${dataset_bucket_uri}/domain=04_dpr/dataset=01_merge/version=2027.01/"
                      ]
                    }
                  ]
                }
              },
              "Next": "Estimate direct payments"
            },
            "Estimate direct payments": {
              "Type": "Task",
              "Resource": "arn:aws:states:::ecs:runTask.sync",
              "Parameters": {
                "Cluster": "${polars_cluster_arn}",
                "TaskDefinition": "${direct_payments_task_arn}",
                "LaunchType": "FARGATE",
                "NetworkConfiguration": {
                  "AwsvpcConfiguration": {
                    "Subnets": ${public_subnet_ids},
                    "SecurityGroups": ["${direct_payments_security_group_id}"],
                    "AssignPublicIp": "ENABLED"
                  }
                },
                "Overrides": {
                  "ContainerOverrides": [
                    {
                      "Name": "_04_direct_payments-container",
                      "Command": [
                        "_02_estimate.py",
                        "--direct_payments_merged_source", "${dataset_bucket_uri}/domain=04_dpr/dataset=01_merge/version=2027.01/",
                        "--destination", "${dataset_bucket_uri}/domain=04_dpr/dataset=02_estimate/version=2027.01/",
                        "--summary_destination", "${dataset_bucket_uri}/domain=04_dpr/dataset=02_estimate_summary/version=2027.01/"
                      ]
                    }
                  ]
                }
              },
              "Next": "Validate and split estimates"
            },
            "Validate and split estimates": {
              "Type": "Parallel",
              "Branches": [
                {
                  "StartAt": "Validate estimate direct payments polars",
                  "States": {
                    "Validate estimate direct payments polars": {
                      "Type": "Task",
                      "Resource": "arn:aws:states:::ecs:runTask.sync",
                      "Parameters": {
                        "Cluster": "${polars_cluster_arn}",
                        "TaskDefinition": "${direct_payments_task_arn}",
                        "LaunchType": "FARGATE",
                        "NetworkConfiguration": {
                          "AwsvpcConfiguration": {
                            "Subnets": ${public_subnet_ids},
                            "SecurityGroups": ["${direct_payments_security_group_id}"],
                            "AssignPublicIp": "ENABLED"
                          }
                        },
                        "Overrides": {
                          "ContainerOverrides": [
                            {
                              "Name": "_04_direct_payments-container",
                              "Command": [
                                "validate_02_estimate.py",
                                "--bucket_name", "${dataset_bucket_name}",
                                "--source_path", "domain=04_dpr/dataset=02_estimate/version=2027.01/",
                                "--reports_path", "domain=04_dpr/dataset=02_estimate_validation/version=2027.01/",
                                "--compare_path", "domain=04_dpr/dataset=01_merge/version=2027.01/"
                              ]
                            }
                          ]
                        }
                      },
                      "End": true
                    }
                  }
                },
                {
                  "StartAt": "Split pa estimates into hybrid areas",
                  "States": {
                    "Split pa estimates into hybrid areas": {
                      "Type": "Task",
                      "Resource": "arn:aws:states:::ecs:runTask.sync",
                      "Parameters": {
                        "Cluster": "${polars_cluster_arn}",
                        "TaskDefinition": "${direct_payments_task_arn}",
                        "LaunchType": "FARGATE",
                        "NetworkConfiguration": {
                          "AwsvpcConfiguration": {
                            "Subnets": ${public_subnet_ids},
                            "SecurityGroups": ["${direct_payments_security_group_id}"],
                            "AssignPublicIp": "ENABLED"
                          }
                        },
                        "Overrides": {
                          "ContainerOverrides": [
                            {
                              "Name": "_04_direct_payments-container",
                              "Command": [
                                "_03_estimates_by_icb_area.py",
                                "--postcode_directory_source", "${dataset_bucket_uri}/domain=01_ons/dataset=postcode_directory_cleaned/",
                                "--pa_filled_posts_source", "${dataset_bucket_uri}/domain=04_dpr/dataset=02_estimate/version=2027.01/",
                                "--destination", "${dataset_bucket_uri}/domain=04_dpr/dataset=03_estimates_by_icb_area/version=2027.01/"
                              ]
                            }
                          ]
                        }
                      },
                      "End": true
                    }
                  }
                }
              ],
              "End": true
            }
          }
        }
      ],
      "Next": "Handle Error and Run Crawlers",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "Handle Error and Run Crawlers",
          "ResultPath": "$.error"
        }
      ]
    },
    "Handle Error and Run Crawlers": {
      "Type": "Parallel",
      "Branches": [
        {
          "StartAt": "Check if Error Exists",
          "States": {
            "Check if Error Exists": {
              "Type": "Choice",
              "Choices": [
                {
                  "Variable": "$.error",
                  "IsPresent": true,
                  "Next": "Publish Error Notification"
                }
              ],
              "Default": "No Error"
            },
            "Publish Error Notification": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke.waitForTaskToken",
              "Parameters": {
                "FunctionName": "${pipeline_failure_lambda_function_arn}:$LATEST",
                "Payload": {
                  "Error.$": "$.error.Cause",
                  "ExecutionId.$": "$$.Execution.Id",
                  "StateMachineName.$": "$$.StateMachine.Name",
                  "StateMachineId.$": "$$.StateMachine.Id",
                  "ExecutionStartTime.$": "$$.Execution.StartTime",
                  "CallbackToken.$": "$$.Task.Token"
                }
              },
              "Next": "Fail"
            },
            "No Error": {
              "Type": "Succeed"
            },
            "Fail": {
              "Type": "Fail"
            }
          }
        },
        {
          "StartAt": "Run DPR Crawler",
          "States": {
            "Run DPR Crawler": {
              "Type": "Task",
              "Resource": "arn:aws:states:::aws-sdk:glue:startCrawler",
              "Parameters": {
                "Name": "${dpr_crawler_name}"
              },
              "End": true
            }
          }
        }
      ],
      "End": true
    }
  }
}
