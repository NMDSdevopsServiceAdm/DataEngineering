{
  "Comment": "Manually-started pipeline to ingest the raw DPR survey and external CSVs, replacing the old ingest_dpr_survey_data_job/ingest_dpr_external_data_job Glue jobs. Before each annual run, edit the '--source' (raw CSV S3 path) below for both branches, commit, and let CI/CD deploy the change - then start this state machine with no execution input needed. The dataset version comes from the dpr_version Terraform variable (terraform/pipeline/variables.tf), shared with Direct-Payment-Recipients.json.",
  "StartAt": "Ingest DPR data in parallel",
  "States": {
    "Ingest DPR data in parallel": {
      "Type": "Parallel",
      "Branches": [
        {
          "StartAt": "Ingest DPR survey data",
          "States": {
            "Ingest DPR survey data": {
              "Type": "Task",
              "Resource": "arn:aws:states:::ecs:runTask.sync",
              "Parameters": {
                "LaunchType": "FARGATE",
                "Cluster": "${polars_cluster_arn}",
                "TaskDefinition": "${ingest_task_arn}",
                "NetworkConfiguration": {
                  "AwsvpcConfiguration": {
                    "Subnets": ${public_subnet_ids},
                    "SecurityGroups": ["${ingest_security_group_id}"],
                    "AssignPublicIp": "ENABLED"
                  }
                },
                "Overrides": {
                  "ContainerOverrides": [
                    {
                      "Name": "_01_ingest-container",
                      "Command": [
                        "ingest_dpr_data.py",
                        "--source",
                        "s3://sfc-2243-dpr-version-raw/domain=DPR/raw_data=2027/survey.csv",
                        "--dataset",
                        "survey",
                        "--destination",
                        "${dataset_bucket_uri}/domain=04_dpr/dataset=00_survey/version=${dpr_version}/"
                      ]
                    }
                  ]
                }
              },
              "End": true
            }
          }
        },
        {
          "StartAt": "Ingest DPR external data",
          "States": {
            "Ingest DPR external data": {
              "Type": "Task",
              "Resource": "arn:aws:states:::ecs:runTask.sync",
              "Parameters": {
                "LaunchType": "FARGATE",
                "Cluster": "${polars_cluster_arn}",
                "TaskDefinition": "${ingest_task_arn}",
                "NetworkConfiguration": {
                  "AwsvpcConfiguration": {
                    "Subnets": ${public_subnet_ids},
                    "SecurityGroups": ["${ingest_security_group_id}"],
                    "AssignPublicIp": "ENABLED"
                  }
                },
                "Overrides": {
                  "ContainerOverrides": [
                    {
                      "Name": "_01_ingest-container",
                      "Command": [
                        "ingest_dpr_data.py",
                        "--source",
                        "s3://sfc-2243-dpr-version-raw/domain=DPR/raw_data=2027/external.csv",
                        "--dataset",
                        "external",
                        "--destination",
                        "${dataset_bucket_uri}/domain=04_dpr/dataset=00_external/version=${dpr_version}/"
                      ]
                    }
                  ]
                }
              },
              "End": true
            }
          }
        }
      ],
      "Next": "Handle Error and Run Crawler",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "Handle Error and Run Crawler"
        }
      ]
    },
    "Handle Error and Run Crawler": {
      "Type": "Parallel",
      "Branches": [
        {
          "StartAt": "Check if Error Exists",
          "States": {
            "Check if Error Exists": {
              "Type": "Choice",
              "Choices": [
                {
                  "Variable": "$.error",
                  "IsPresent": true,
                  "Next": "Publish Error Notification"
                }
              ],
              "Default": "No Error"
            },
            "Publish Error Notification": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke.waitForTaskToken",
              "Parameters": {
                "FunctionName": "${pipeline_failure_lambda_function_arn}:$LATEST",
                "Payload": {
                  "Error.$": "$.error.Cause",
                  "ExecutionId.$": "$$.Execution.Id",
                  "StateMachineName.$": "$$.StateMachine.Name",
                  "StateMachineId.$": "$$.StateMachine.Id",
                  "ExecutionStartTime.$": "$$.Execution.StartTime",
                  "CallbackToken.$": "$$.Task.Token"
                }
              },
              "Next": "Fail"
            },
            "No Error": {
              "Type": "Succeed"
            },
            "Fail": {
              "Type": "Fail"
            }
          }
        },
        {
          "StartAt": "Run DPR Crawler",
          "States": {
            "Run DPR Crawler": {
              "Type": "Task",
              "Resource": "arn:aws:states:::aws-sdk:glue:startCrawler",
              "Parameters": {
                "Name": "${dpr_crawler_name}"
              },
              "End": true
            }
          }
        }
      ],
      "End": true
    }
  }
}
