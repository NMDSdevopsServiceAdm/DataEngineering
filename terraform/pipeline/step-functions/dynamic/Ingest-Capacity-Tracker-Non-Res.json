{
  "Comment": "A step function to ingest, clean and validate Capacity Tracker Non Residential data",
  "StartAt": "Capacity Tracker Non Residential pipeline",
  "States": {
    "Capacity Tracker Non Residential pipeline": {
      "Type": "Parallel",
      "Branches": [
        {
          "StartAt": "Ingest Capacity Tracker Non Res",
          "States": {
            "Ingest Capacity Tracker Non Res": {
              "Type": "Task",
              "Resource": "arn:aws:states:::ecs:runTask.sync",
              "Parameters": {
                "LaunchType": "FARGATE",
                "Cluster": "${polars_cluster_arn}",
                "TaskDefinition": "${ingest_task_arn}",
                "NetworkConfiguration": {
                  "AwsvpcConfiguration": {
                    "Subnets": ${public_subnet_ids},
                    "SecurityGroups": ["${ingest_security_group_id}"],
                    "AssignPublicIp": "ENABLED"
                  }
                },
                "Overrides": {
                  "ContainerOverrides": [
                    {
                      "Name": "_01_ingest-container",
                      "Command.$": "States.Array('ingest_capacity_tracker_data.py', '--source', $.jobs.ingest_capacity_tracker_data.source, '--destination', '${dataset_bucket_uri}/domain=capacity_tracker/dataset=capacity_tracker_non_residential/')"
                    }
                  ]
                }
              },
              "Next": "Clean Capacity Tracker Non Res data"
            },
            "Clean Capacity Tracker Non Res data": {
              "Type": "Task",
              "Resource": "arn:aws:states:::ecs:runTask.sync",
              "Parameters": {
                "LaunchType": "FARGATE",
                "Cluster": "${polars_cluster_arn}",
                "TaskDefinition": "${ingest_task_arn}",
                "NetworkConfiguration": {
                  "AwsvpcConfiguration": {
                    "Subnets": ${public_subnet_ids},
                    "SecurityGroups": ["${ingest_security_group_id}"],
                    "AssignPublicIp": "ENABLED"
                  }
                },
                "Overrides": {
                  "ContainerOverrides": [
                    {
                      "Name": "_01_ingest-container",
                      "Command": [
                        "clean_capacity_tracker_non_res_data.py",
                        "--capacity_tracker_non_res_source",
                        "${dataset_bucket_uri}/domain=capacity_tracker/dataset=capacity_tracker_non_residential/",
                        "--cleaned_capacity_tracker_non_res_destination",
                        "${dataset_bucket_uri}/domain=capacity_tracker/dataset=capacity_tracker_non_residential_cleaned/"
                      ]
                    }
                  ]
                }
              },
              "Next": "Validate cleaned CT Non Res data"
            },
            "Validate cleaned CT Non Res data": {
              "Type": "Task",
              "Resource": "arn:aws:states:::ecs:runTask.sync",
              "Parameters": {
                "LaunchType": "FARGATE",
                "Cluster": "${polars_cluster_arn}",
                "TaskDefinition": "${ingest_task_arn}",
                "NetworkConfiguration": {
                  "AwsvpcConfiguration": {
                    "Subnets": ${public_subnet_ids},
                    "SecurityGroups": ["${ingest_security_group_id}"],
                    "AssignPublicIp": "ENABLED"
                  }
                },
                "Overrides": {
                  "ContainerOverrides": [
                    {
                      "Name": "_01_ingest-container",
                      "Command": [
                        "validate_clean_capacity_tracker_non_res_data.py",
                        "--bucket_name",
                        "${dataset_bucket_name}",
                        "--source_path",
                        "domain=capacity_tracker/dataset=capacity_tracker_non_residential_cleaned/",
                        "--reports_path",
                        "domain=data_validation_reports/dataset=validation_capacity_tracker_non_residential_cleaned/",
                        "--compare_path",
                        "domain=capacity_tracker/dataset=capacity_tracker_non_residential/"
                      ]
                    }
                  ]
                }
              },
              "End": true
            }
          }
        }
      ],
      "Next": "Run Crawler and Handle Error",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "Run Crawler and Handle Error",
          "ResultPath": "$.error"
        }
      ]
    },
    "Run Crawler and Handle Error": {
      "Type": "Parallel",
      "Branches": [
        {
          "StartAt": "Run CT Crawler",
          "States": {
            "Run CT Crawler": {
              "Type": "Task",
              "Resource": "arn:aws:states:::states:startExecution.sync:2",
              "Parameters": {
                "StateMachineArn": "${run_crawler_state_machine_arn}",
                "Input": {
                  "crawler_name": "${ct_crawler_name}",
                  "AWS_STEP_FUNCTIONS_STARTED_BY_EXECUTION_ID.$": "$$.Execution.Id"
                }
              },
              "End": true
            }
          }
        },
        {
          "StartAt": "Check if Error Exists",
          "States": {
            "Check if Error Exists": {
              "Type": "Choice",
              "Choices": [
                {
                  "Variable": "$.error",
                  "IsPresent": true,
                  "Next": "Publish Error Notification"
                }
              ],
              "Default": "No Error"
            },
            "No Error": {
              "Type": "Succeed"
            },
            "Publish Error Notification": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke.waitForTaskToken",
              "Parameters": {
                "FunctionName": "${pipeline_failure_lambda_function_arn}:$LATEST",
                "Payload": {
                  "Error.$": "$.error.Cause",
                  "ExecutionId.$": "$$.Execution.Id",
                  "StateMachineName.$": "$$.StateMachine.Name",
                  "StateMachineId.$": "$$.StateMachine.Id",
                  "ExecutionStartTime.$": "$$.Execution.StartTime",
                  "CallbackToken.$": "$$.Task.Token"
                }
              },
              "Next": "Fail"
            },
            "Fail": {
              "Type": "Fail"
            }
          }
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "Handle Crawler Error"
        }
      ],
      "Next": "Success"
    },
    "Handle Crawler Error": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke.waitForTaskToken",
      "Parameters": {
        "FunctionName": "${pipeline_failure_lambda_function_arn}:$LATEST",
        "Payload": {
          "Error.$": "$.error.Cause",
          "ExecutionId.$": "$$.Execution.Id",
          "StateMachineName.$": "$$.StateMachine.Name",
          "StateMachineId.$": "$$.StateMachine.Id",
          "ExecutionStartTime.$": "$$.Execution.StartTime",
          "CallbackToken.$": "$$.Task.Token"
        }
      },
      "Next": "Fail (Crawler)"
    },
    "Fail (Crawler)": {
      "Type": "Fail"
    },
    "Success": {
      "Type": "Succeed"
    }
  }
}
