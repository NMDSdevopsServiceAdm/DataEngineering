{
  "Comment": "THROWAWAY - ticket 1906 OOM investigation, FIX_VARIANT=A (remove the plain .collect()). Manual-start only, never referenced by an orchestrator. Delete once the investigation concludes.",
  "StartAt": "Run ASCWDS OOM Diagnostic Prototype A",
  "States": {
    "Run ASCWDS OOM Diagnostic Prototype A": {
      "Type": "Task",
      "Resource": "arn:aws:states:::ecs:runTask.sync",
      "Parameters": {
        "LaunchType": "FARGATE",
        "Cluster": "${polars_cluster_arn}",
        "TaskDefinition": "${ascwds_oom_diag_task_arn}",
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "Subnets": ${public_subnet_ids},
            "SecurityGroups": ["${ascwds_oom_diag_security_group_id}"],
            "AssignPublicIp": "ENABLED"
          }
        },
        "Overrides": {
          "ContainerOverrides": [
            {
              "Name": "ascwds-oom-diag-container",
              "Command": [
                "clean_ascwds_workplace_prototype.py",
                "--workplace_source",
                "${dataset_bucket_uri}/domain=ASCWDS/dataset=workplace/",
                "--data_labels_source",
                "${dataset_bucket_uri}/domain=ASCWDS/dataset=data_labels/data_labels_lookup.csv",
                "--cleaned_workplace_destination",
                "${dataset_bucket_uri}/domain=ASCWDS/dataset=workplace_cleaned_prototype_a/",
                "--ascwds_for_sfc_internal_destination",
                "${dataset_bucket_uri}/domain=SfC/dataset=ascwds_for_sfc_internal_prototype_a/"
              ],
              "Environment": [
                { "Name": "FIX_VARIANT", "Value": "A" }
              ]
            }
          ]
        }
      },
      "End": true
    }
  }
}
