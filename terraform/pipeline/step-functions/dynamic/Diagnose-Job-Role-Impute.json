{
  "Comment": "THROWAWAY. Manual-start only. Runs the instrumented copy of the job role imputation step so its memory profile can be measured against real data. Writes to its own dataset name so it can never overwrite the real pipeline's output. Delete with _03_impute_prototype.py.",
  "StartAt": "Diagnose Job Role Impute",
  "States": {
    "Diagnose Job Role Impute": {
      "Type": "Task",
      "Resource": "arn:aws:states:::ecs:runTask.sync",
      "Parameters": {
        "Cluster": "${polars_cluster_arn}",
        "TaskDefinition": "${independent_cqc_prototype_task_arn}",
        "LaunchType": "FARGATE",
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "Subnets": ${public_subnet_ids},
            "SecurityGroups": ["${independent_cqc_prototype_security_group_id}"],
            "AssignPublicIp": "ENABLED"
          }
        },
        "Overrides": {
          "ContainerOverrides": [
            {
              "Name": "_03_independent_cqc_prototype-container",
              "Command": [
                "_03_impute_prototype.py",
                "--cleaned_data_source", "${dataset_bucket_uri}/domain=ind_cqc_filled_posts/dataset=ind_cqc_07_02_clean_job_roles/",
                "--imputed_data_destination", "${dataset_bucket_uri}/domain=ind_cqc_filled_posts/dataset=ind_cqc_07_03_impute_job_roles_diagnostics/"
              ]
            }
          ]
        }
      },
      "End": true
    }
  }
}
