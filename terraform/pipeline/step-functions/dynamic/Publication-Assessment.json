{
  "Comment": "Prepares the data of one archived run and builds its assessment data",
  "StartAt": "Choose run",
  "States": {
    "Choose run": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.run_number",
          "IsPresent": true,
          "Next": "Use requested run"
        }
      ],
      "Default": "Use latest run"
    },
    "Use requested run": {
      "Type": "Pass",
      "Parameters": {
        "run_number.$": "$.run_number"
      },
      "Next": "Prepare and assess publication data"
    },
    "Use latest run": {
      "Type": "Pass",
      "Result": {
        "run_number": "latest"
      },
      "Next": "Prepare and assess publication data"
    },
    "Prepare and assess publication data": {
      "Type": "Parallel",
      "Next": "Handle Error and Run Crawlers",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "Handle Error and Run Crawlers",
          "ResultPath": "$.error"
        }
      ],
      "Branches": [
        {
          "StartAt": "Merge and prep data",
          "States": {
            "Merge and prep data": {
              "Type": "Task",
              "Resource": "arn:aws:states:::ecs:runTask.sync",
              "Parameters": {
                "Cluster": "${polars_cluster_arn}",
                "TaskDefinition": "${publication_task_arn}",
                "LaunchType": "FARGATE",
                "NetworkConfiguration": {
                  "AwsvpcConfiguration": {
                    "Subnets": ${public_subnet_ids},
                    "SecurityGroups": ["${publication_security_group_id}"],
                    "AssignPublicIp": "ENABLED"
                  }
                },
                "Overrides": {
                  "ContainerOverrides": [
                    {
                      "Name": "_99_publication-container",
                      "Command.$": "States.Array('_01_merge_and_prep.py', '--jr_archive_estimates_source', '${dataset_bucket_uri}/domain=03_ind_cqc/dataset=01_filled_posts_08_archived_job_role_estimates/', '--jr_archive_metadata_source', '${dataset_bucket_uri}/domain=03_ind_cqc/dataset=01_filled_posts_08_archived_job_role_estimates_metadata/', '--prep_destination', '${dataset_bucket_uri}/domain=99_publication/dataset=monthly_tracker_filled_posts_01_merge_and_prep/', '--run_number', States.Format('{}', $.run_number))"
                    }
                  ]
                }
              },
              "ResultPath": null,
              "Next": "Assess data"
            },
            "Assess data": {
              "Type": "Task",
              "Resource": "arn:aws:states:::ecs:runTask.sync",
              "Parameters": {
                "Cluster": "${polars_cluster_arn}",
                "TaskDefinition": "${publication_task_arn}",
                "LaunchType": "FARGATE",
                "NetworkConfiguration": {
                  "AwsvpcConfiguration": {
                    "Subnets": ${public_subnet_ids},
                    "SecurityGroups": ["${publication_security_group_id}"],
                    "AssignPublicIp": "ENABLED"
                  }
                },
                "Overrides": {
                  "ContainerOverrides": [
                    {
                      "Name": "_99_publication-container",
                      "Command.$": "States.Array('_02_assessment.py', '--prep_source', '${dataset_bucket_uri}/domain=99_publication/dataset=monthly_tracker_filled_posts_01_merge_and_prep/', '--assessment_destination', '${dataset_bucket_uri}/domain=99_publication/dataset=monthly_tracker_filled_posts_02_assessment/', '--run_number', States.Format('{}', $.run_number))"
                    }
                  ]
                }
              },
              "End": true
            }
          }
        }
      ]
    },
    "Handle Error and Run Crawlers": {
      "Type": "Parallel",
      "End": true,
      "Branches": [
        {
          "StartAt": "Check if Error Exists",
          "States": {
            "Check if Error Exists": {
              "Type": "Choice",
              "Choices": [
                {
                  "Variable": "$.error",
                  "IsPresent": true,
                  "Next": "Publish Error Notification"
                }
              ],
              "Default": "No Error"
            },
            "Publish Error Notification": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke.waitForTaskToken",
              "Parameters": {
                "FunctionName": "${pipeline_failure_lambda_function_arn}:$LATEST",
                "Payload": {
                  "Error.$": "$.error.Cause",
                  "ExecutionId.$": "$$.Execution.Id",
                  "StateMachineName.$": "$$.StateMachine.Name",
                  "StateMachineId.$": "$$.StateMachine.Id",
                  "ExecutionStartTime.$": "$$.Execution.StartTime",
                  "CallbackToken.$": "$$.Task.Token"
                }
              },
              "Next": "Fail"
            },
            "No Error": {
              "Type": "Succeed"
            },
            "Fail": {
              "Type": "Fail"
            }
          }
        },
        {
          "StartAt": "Run Publication Crawler",
          "States": {
            "Run Publication Crawler": {
              "Type": "Task",
              "Resource": "arn:aws:states:::states:startExecution.sync:2",
              "Parameters": {
                "StateMachineArn": "${run_crawler_state_machine_arn}",
                "Input": {
                  "crawler_name": "${publication_crawler_name}",
                  "AWS_STEP_FUNCTIONS_STARTED_BY_EXECUTION_ID.$": "$$.Execution.Id"
                }
              },
              "End": true
            }
          }
        }
      ]
    }
  }
}
