{
  "Comment": "A step function to ingest, clean and validate CQC PIR data",
  "StartAt": "CQC PIR pipeline",
  "States": {
    "CQC PIR pipeline": {
      "Type": "Parallel",
      "Next": "Run CQC crawler when success",
      "Branches": [
        {
          "StartAt": "Ingest CQC PIR",
          "States": {
            "Ingest CQC PIR": {
              "Type": "Task",
              "Resource": "arn:aws:states:::ecs:runTask.sync",
              "Parameters": {
                "LaunchType": "FARGATE",
                "Cluster": "${polars_cluster_arn}",
                "TaskDefinition": "${ingest_task_arn}",
                "NetworkConfiguration": {
                  "AwsvpcConfiguration": {
                    "Subnets": ${public_subnet_ids},
                    "SecurityGroups": ["${ingest_security_group_id}"],
                    "AssignPublicIp": "ENABLED"
                  }
                },
                "Overrides": {
                  "ContainerOverrides": [
                    {
                      "Name": "_01_ingest-container",
                      "Command.$": "States.Array('ingest_cqc_pir_data.py', '--source', $.jobs.ingest_cqc_pir_data.source, '--destination_prefix', '${dataset_bucket_uri}/')"
                    }
                  ]
                }
              },
              "Next": "Clean and validate ingested CQC data"
            },
            "Clean and validate ingested CQC data": {
              "Type": "Parallel",
              "End": true,
              "Branches": [
                {
                  "StartAt": "Validate Ingested CQC PIR data",
                  "States": {
                      "Validate Ingested CQC PIR data": {
                      "Type": "Task",
                      "Resource": "arn:aws:states:::ecs:runTask.sync",
                      "Parameters": {
                        "LaunchType": "FARGATE",
                        "Cluster": "${polars_cluster_arn}",
                        "TaskDefinition": "${ingest_task_arn}",
                        "NetworkConfiguration": {
                          "AwsvpcConfiguration": {
                            "Subnets": ${public_subnet_ids},
                            "SecurityGroups": ["${ingest_security_group_id}"],
                            "AssignPublicIp": "ENABLED"
                          }
                        },
                        "Overrides": {
                          "ContainerOverrides": [
                            {
                              "Name": "_01_ingest-container",
                              "Command": [
                                "validate_cqc_pir_raw_data.py",
                                "--bucket_name",
                                "${dataset_bucket_name}",
                                "--source_path",
                                "domain=01_cqc/dataset=pir/",
                                "--reports_path",
                                "domain=01_cqc/dataset=pir_validation/"
                              ]
                            }
                          ]
                        }
                      },
                      "End": true
                    }
                  }
                },
                {
                  "StartAt": "Clean CQC PIR data",
                  "States": {
                    "Clean CQC PIR data": {
                      "Type": "Task",
                      "Resource": "arn:aws:states:::ecs:runTask.sync",
                      "Parameters": {
                        "LaunchType": "FARGATE",
                        "Cluster": "${polars_cluster_arn}",
                        "TaskDefinition": "${ingest_task_arn}",
                        "NetworkConfiguration": {
                          "AwsvpcConfiguration": {
                            "Subnets": ${public_subnet_ids},
                            "SecurityGroups": ["${ingest_security_group_id}"],
                            "AssignPublicIp": "ENABLED"
                          }
                        },
                        "Overrides": {
                          "ContainerOverrides": [
                            {
                              "Name": "_01_ingest-container",
                              "Command": [
                                "clean_cqc_pir_data.py",
                                "--cqc_pir_source",
                                "${dataset_bucket_uri}/domain=01_cqc/dataset=pir/",
                                "--cleaned_cqc_pir_destination",
                                "${dataset_bucket_uri}/domain=01_cqc/dataset=pir_cleaned/"
                              ]
                            }
                          ]
                        }
                      },
                      "Next": "Validate Cleaned CQC PIR data"
                    },
                    "Validate Cleaned CQC PIR data": {
                      "Type": "Task",
                      "Resource": "arn:aws:states:::ecs:runTask.sync",
                      "Parameters": {
                        "LaunchType": "FARGATE",
                        "Cluster": "${polars_cluster_arn}",
                        "TaskDefinition": "${ingest_task_arn}",
                        "NetworkConfiguration": {
                          "AwsvpcConfiguration": {
                            "Subnets": ${public_subnet_ids},
                            "SecurityGroups": ["${ingest_security_group_id}"],
                            "AssignPublicIp": "ENABLED"
                          }
                        },
                        "Overrides": {
                          "ContainerOverrides": [
                            {
                              "Name": "_01_ingest-container",
                              "Command": [
                                "validate_clean_cqc_pir_data.py",
                                "--bucket_name",
                                "${dataset_bucket_name}",
                                "--source_path",
                                "domain=01_cqc/dataset=pir_cleaned/",
                                "--reports_path",
                                "domain=01_cqc/dataset=pir_cleaned_validation/"
                              ]
                            }
                          ]
                        }
                      },
                      "End": true
                    }
                  }
                }
              ]
            }
          }
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "Publish error notification",
          "ResultPath": "$.error"
        }
      ]
    },
    "Run CQC crawler when success": {
      "Type": "Task",
      "Parameters": {
        "Name": "${cqc_crawler_name}"
      },
      "Resource": "arn:aws:states:::aws-sdk:glue:startCrawler",
      "Next": "Success"
    },
    "Publish error notification": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke.waitForTaskToken",
      "Parameters": {
        "FunctionName": "${pipeline_failure_lambda_function_arn}:$LATEST",
        "Payload": {
          "Error.$": "$.error.Cause",
          "ExecutionId.$": "$$.Execution.Id",
          "StateMachineName.$": "$$.StateMachine.Name",
          "StateMachineId.$": "$$.StateMachine.Id",
          "ExecutionStartTime.$": "$$.Execution.StartTime",
          "CallbackToken.$": "$$.Task.Token"
        }
      },
      "Next": "Run CQC crawler when failed"
    },
    "Run CQC crawler when failed": {
      "Type": "Task",
      "Parameters": {
        "Name": "${cqc_crawler_name}"
      },
      "Resource": "arn:aws:states:::aws-sdk:glue:startCrawler",
      "Next": "Fail"
    },
    "Fail": {
      "Type": "Fail"
    },
    "Success": {
      "Type": "Succeed"
    }
  }
}
