{
  "Comment": "THROWAWAY, manually started. Memory diagnostic for the hackathon worker turnover job. Input: {\"stop_after\": \"filter\" | \"flag\" | \"full\", \"materialize\": \"none\" | \"collect\" | \"cache\" | \"sink\"}. Delete before merge.",
  "StartAt": "Diagnose worker turnover",
  "States": {
    "Diagnose worker turnover": {
      "Type": "Task",
      "Resource": "arn:aws:states:::ecs:runTask.sync",
      "Parameters": {
        "LaunchType": "FARGATE",
        "Cluster": "${polars_cluster_arn}",
        "TaskDefinition": "${hackathon_task_arn}",
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "Subnets": ${public_subnet_ids},
            "SecurityGroups": ["${hackathon_security_group_id}"],
            "AssignPublicIp": "ENABLED"
          }
        },
        "Overrides": {
          "ContainerOverrides": [
            {
              "Name": "_98_hackathon-container",
              "Environment": [
                {
                  "Name": "POLARS_VERBOSE",
                  "Value": "1"
                },
                {
                  "Name": "DIAG_STOP_AFTER",
                  "Value.$": "$.stop_after"
                },
                {
                  "Name": "DIAG_MATERIALIZE",
                  "Value.$": "$.materialize"
                }
              ],
              "Command": [
                "_01_worker_turnover_prototype.py",
                "--cleaned_ascwds_worker_source",
                "${dataset_bucket_uri}/domain=01_ascwds/dataset=worker_cleaned/",
                "--raw_ascwds_worker_source",
                "${dataset_bucket_uri}/domain=01_ascwds/dataset=worker/",
                "--destination",
                "${dataset_bucket_uri}/domain=98_hackathon/dataset=worker_turnover_diag/"
              ]
            }
          ]
        }
      },
      "End": true
    }
  }
}
