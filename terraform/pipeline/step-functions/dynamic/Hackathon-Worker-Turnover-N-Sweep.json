                    "AssignPublicIp": "ENABLED"
                  }
                },
                "Overrides": {
                  "ContainerOverrides": [
                    {
                      "Name": "_98_hackathon-container",
                      "Command": [
                        "_01_worker_turnover.py",
                        "--cleaned_ascwds_worker_source",
                        "${dataset_bucket_uri}/domain=01_ascwds/dataset=worker_cleaned/",
                        "--flagged_destination",
                        "${dataset_bucket_uri}/domain=98_hackathon/dataset=worker_turnover_01_flagged_n2/",
                        "--n_months",
                        "2"
                      ]
                    }
                  ]
                }
              },
              "End": true
            }
          }
        },
        {
          "StartAt": "Flag with N=3",
