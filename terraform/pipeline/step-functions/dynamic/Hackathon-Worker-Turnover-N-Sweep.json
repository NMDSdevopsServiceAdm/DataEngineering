{
  "Comment": "Temporary and manually-started. Runs the worker turnover flagging in parallel with n_months 1 to 5, each to its own output, so the best value can be chosen, then runs the crawler. Delete once the value is chosen. Start with no execution input.",
  "StartAt": "Flag for each n_months",
  "States": {
    "Flag for each n_months": {
      "Type": "Parallel",
      "Branches": [
        {
          "StartAt": "Flag with N=1",
          "States": {
            "Flag with N=1": {
              "Type": "Task",
              "Resource": "arn:aws:states:::ecs:runTask.sync",
              "Parameters": {
                "LaunchType": "FARGATE",
                "Cluster": "${polars_cluster_arn}",
                "TaskDefinition": "${hackathon_task_arn}",
                "NetworkConfiguration": {
                  "AwsvpcConfiguration": {
                    "Subnets": ${public_subnet_ids},
                    "SecurityGroups": ["${hackathon_security_group_id}"],
                    "AssignPublicIp": "ENABLED"
                  }
                },
                "Overrides": {
                  "ContainerOverrides": [
                    {
                      "Name": "_98_hackathon-container",
                      "Command": [
                        "_01_worker_turnover.py",
                        "--cleaned_ascwds_worker_source",
                        "${dataset_bucket_uri}/domain=01_ascwds/dataset=worker_cleaned/",
                        "--flagged_destination",
                        "${dataset_bucket_uri}/domain=98_hackathon/dataset=worker_turnover_01_flagged_n1/",
                        "--n_months",
                        "1"
                      ]
                    }
                  ]
                }
              },
              "End": true
            }
          }
        },
        {
          "StartAt": "Flag with N=2",
          "States": {
            "Flag with N=2": {
              "Type": "Task",
              "Resource": "arn:aws:states:::ecs:runTask.sync",
