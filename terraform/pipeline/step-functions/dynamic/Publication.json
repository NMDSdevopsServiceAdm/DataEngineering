{
  "StartAt": "Choose run",
  "States": {
    "Choose run": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.run_number",
          "IsPresent": true,
          "Next": "Use requested run"
        }
      ],
      "Default": "Use latest run"
    },
    "Use requested run": {
      "Type": "Pass",
      "Parameters": {
        "run_number.$": "$.run_number"
      },
      "Next": "Merge and clean publication data"
    },
    "Use latest run": {
      "Type": "Pass",
      "Result": {
        "run_number": "latest"
      },
      "Next": "Merge and clean publication data"
    },
    "Merge and clean publication data": {
      "Type": "Parallel",
      "Next": "Handle Error and Run Crawlers",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "Handle Error and Run Crawlers",
          "ResultPath": "$.error"
        }
      ],
      "Branches": [
        {
          "StartAt": "Merge data",
          "States": {
            "Merge data": {
              "Type": "Task",
              "Resource": "arn:aws:states:::ecs:runTask.sync",
              "Parameters": {
                "Cluster": "${polars_cluster_arn}",
                "TaskDefinition": "${publication_task_arn}",
                "LaunchType": "FARGATE",
                "NetworkConfiguration": {
                  "AwsvpcConfiguration": {
                    "Subnets": ${public_subnet_ids},
                    "SecurityGroups": ["${publication_security_group_id}"],
                    "AssignPublicIp": "ENABLED"
                  }
                },
                "Overrides": {
                  "ContainerOverrides": [
                    {
                      "Name": "_99_publication-container",
                      "Command.$": "States.Array('_01_merge.py', '--jr_archive_estimates_source', '${dataset_bucket_uri}/domain=03_ind_cqc/dataset=01_filled_posts_08_archived_job_role_estimates/', '--jr_archive_metadata_source', '${dataset_bucket_uri}/domain=03_ind_cqc/dataset=01_filled_posts_08_archived_job_role_estimates_metadata/', '--merge_data_destination', '${dataset_bucket_uri}/domain=99_publication/dataset=monthly_tracker_filled_posts_01_merge/', '--run_number', States.Format('{}', $.run_number))"
                    }
                  ]
                }
              },
              "Next": "Clean data"
            },
            "Clean data": {
              "Type": "Task",
              "Resource": "arn:aws:states:::ecs:runTask.sync",
              "Parameters": {
                "Cluster": "${polars_cluster_arn}",
                "TaskDefinition": "${publication_task_arn}",
                "LaunchType": "FARGATE",
                "NetworkConfiguration": {
                  "AwsvpcConfiguration": {
                    "Subnets": ${public_subnet_ids},
                    "SecurityGroups": ["${publication_security_group_id}"],
                    "AssignPublicIp": "ENABLED"
                  }
                },
                "Overrides": {
                  "ContainerOverrides": [
                    {
                      "Name": "_99_publication-container",
                      "Command": [
                        "_02_clean.py",
                        "--merge_data_source", "${dataset_bucket_uri}/domain=99_publication/dataset=monthly_tracker_filled_posts_01_merge/",
                        "--clean_destination", "${dataset_bucket_uri}/domain=99_publication/dataset=monthly_tracker_filled_posts_02_clean/",
                        "--t0_destination", "${dataset_bucket_uri}/domain=99_publication/dataset=monthly_tracker_filled_posts_02_t0_estimates/",
                        "--t1_destination", "${dataset_bucket_uri}/domain=99_publication/dataset=monthly_tracker_filled_posts_02_t1_filled_posts_perc_change/",
                        "--t2_destination", "${dataset_bucket_uri}/domain=99_publication/dataset=monthly_tracker_filled_posts_02_t2_location_count_perc_change/"
                      ]
                    }
                  ]
                }
              },
              "End": true
            }
          }
        }
      ]
    },
    "Handle Error and Run Crawlers": {
      "Type": "Parallel",
      "End": true,
      "Branches": [
        {
          "StartAt": "Check if Error Exists",
          "States": {
            "Check if Error Exists": {
              "Type": "Choice",
              "Choices": [
                {
                  "Variable": "$.error",
                  "IsPresent": true,
                  "Next": "Publish Error Notification"
                }
              ],
              "Default": "No Error"
            },
            "Publish Error Notification": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke.waitForTaskToken",
              "Parameters": {
                "FunctionName": "${pipeline_failure_lambda_function_arn}:$LATEST",
                "Payload": {
                  "Error.$": "$.error.Cause",
                  "ExecutionId.$": "$$.Execution.Id",
                  "StateMachineName.$": "$$.StateMachine.Name",
                  "StateMachineId.$": "$$.StateMachine.Id",
                  "ExecutionStartTime.$": "$$.Execution.StartTime",
                  "CallbackToken.$": "$$.Task.Token"
                }
              },
              "Next": "Fail"
            },
            "No Error": {
              "Type": "Succeed"
            },
            "Fail": {
              "Type": "Fail"
            }
          }
        },
        {
          "StartAt": "Run Publication Crawler",
          "States": {
            "Run Publication Crawler": {
              "Type": "Task",
              "Resource": "arn:aws:states:::aws-sdk:glue:startCrawler",
              "Parameters": {
                "Name": "${publication_crawler_name}"
              },
              "End": true
            }
          }
        }
      ]
    }
  }
}
