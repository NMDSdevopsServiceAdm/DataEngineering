{
  "StartAt": "Merge, clean and validate publication data",
  "States": {
    "Merge, clean and validate publication data": {
      "Type": "Parallel",
      "Next": "Handle Error and Run Crawlers",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "Handle Error and Run Crawlers",
          "ResultPath": "$.error"
        }
      ],
      "Branches": [
        {
          "StartAt": "Merge data",
          "States": {
            "Merge data": {
              "Type": "Task",
              "Resource": "arn:aws:states:::ecs:runTask.sync",
              "Parameters": {
                "Cluster": "${polars_cluster_arn}",
                "TaskDefinition": "${publication_task_arn}",
                "LaunchType": "FARGATE",
                "NetworkConfiguration": {
                  "AwsvpcConfiguration": {
                    "Subnets": ${public_subnet_ids},
                    "SecurityGroups": ["${publication_security_group_id}"],
                    "AssignPublicIp": "ENABLED"
                  }
                },
                "Overrides": {
                  "ContainerOverrides": [
                    {
                      "Name": "_08_publication-container",
                      "Command": [
                        "_01_merge_pub_data.py",
                        "--jr_archive_estimates_source", "${dataset_bucket_uri}/domain=sample_archive_data/dataset=estimates_by_job_role/archive_date=2026/run_number=1/job_role_estimates.parquet",
                        "--jr_archive_metadata_source", "${dataset_bucket_uri}/domain=sample_archive_data/dataset=estimates_by_job_role/archive_date=2026/run_number=1/metadata.parquet",
                        "--jr_archive_geography_source", "${dataset_bucket_uri}/domain=sample_archive_data/dataset=estimates_by_job_role/archive_date=2026/run_number=1/geography.parquet",
                        "--merge_data_destination", "${dataset_bucket_uri}/domain=publication/dataset=publication_01_merged_data/"
                      ]
                    }
                  ]
                }
              },
              "Next": "Clean and validate merged data"
            },
            "Clean and validate merged data": {
              "Type": "Parallel",
              "Next": "Validate cleaned data",
              "Branches": [
                {
                  "StartAt": "Clean data",
                  "States": {
                    "Clean data": {
                      "Type": "Task",
                      "Resource": "arn:aws:states:::ecs:runTask.sync",
                      "Parameters": {
                        "Cluster": "${polars_cluster_arn}",
                        "TaskDefinition": "${publication_task_arn}",
                        "LaunchType": "FARGATE",
                        "NetworkConfiguration": {
                          "AwsvpcConfiguration": {
                            "Subnets": ${public_subnet_ids},
                            "SecurityGroups": ["${publication_security_group_id}"],
                            "AssignPublicIp": "ENABLED"
                          }
                        },
                        "Overrides": {
                          "ContainerOverrides": [
                            {
                              "Name": "_08_publication-container",
                              "Command": [
                                "_02_clean_pub_data.py",
                                "--merge_data_source", "${dataset_bucket_uri}/domain=publication/dataset=publication_01_merged_data/",
                                "--clean_destination", "${dataset_bucket_uri}/domain=publication/dataset=publication_02_cleaned_data/"
                              ]
                            }
                          ]
                        }
                      },
                      "End": true
                    }
                  }
                },
                {
                  "StartAt": "Validate merged data",
                  "States": {
                    "Validate merged data": {
                      "Type": "Task",
                      "Resource": "arn:aws:states:::ecs:runTask.sync",
                      "Parameters": {
                        "Cluster": "${polars_cluster_arn}",
                        "TaskDefinition": "${publication_task_arn}",
                        "LaunchType": "FARGATE",
                        "NetworkConfiguration": {
                          "AwsvpcConfiguration": {
                            "Subnets": ${public_subnet_ids},
                            "SecurityGroups": ["${publication_security_group_id}"],
                            "AssignPublicIp": "ENABLED"
                          }
                        },
                        "Overrides": {
                          "ContainerOverrides": [
                            {
                              "Name": "_08_publication-container",
                              "Command": [
                                "validate_01_merge_pub_data.py",
                                "--bucket_name", "${dataset_bucket_name}",
                                "--source_path", "domain=publication/dataset=publication_01_merged_data/",
                                "--compare_path", "domain=sample_archive_data/dataset=estimates_by_job_role/archive_date=2026/run_number=1/job_role_estimates.parquet",
                                "--reports_path", "domain=data_validation_reports/dataset=validation_publication_01_merged_data/"
                              ]
                            }
                          ]
                        }
                      },
                      "End": true
                    }
                  }
                }
              ]
            },
            "Validate cleaned data": {
              "Type": "Task",
              "Resource": "arn:aws:states:::ecs:runTask.sync",
              "Parameters": {
                "Cluster": "${polars_cluster_arn}",
                "TaskDefinition": "${publication_task_arn}",
                "LaunchType": "FARGATE",
                "NetworkConfiguration": {
                  "AwsvpcConfiguration": {
                    "Subnets": ${public_subnet_ids},
                    "SecurityGroups": ["${publication_security_group_id}"],
                    "AssignPublicIp": "ENABLED"
                  }
                },
                "Overrides": {
                  "ContainerOverrides": [
                    {
                      "Name": "_08_publication-container",
                      "Command": [
                        "validate_02_clean_pub_data.py",
                        "--bucket_name", "${dataset_bucket_name}",
                        "--source_path", "domain=publication/dataset=publication_02_cleaned_data/",
                        "--compare_path", "domain=publication/dataset=publication_01_merged_data/",
                        "--reports_path", "domain=data_validation_reports/dataset=validation_publication_02_cleaned_data/"
                      ]
                    }
                  ]
                }
              },
              "End": true
            }
          }
        }
      ]
    },
    "Handle Error and Run Crawlers": {
      "Type": "Parallel",
      "End": true,
      "Branches": [
        {
          "StartAt": "Check if Error Exists",
          "States": {
            "Check if Error Exists": {
              "Type": "Choice",
              "Choices": [
                {
                  "Variable": "$.error",
                  "IsPresent": true,
                  "Next": "Publish Error Notification"
                }
              ],
              "Default": "No Error"
            },
            "Publish Error Notification": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke.waitForTaskToken",
              "Parameters": {
                "FunctionName": "${pipeline_failure_lambda_function_arn}:$LATEST",
                "Payload": {
                  "Error.$": "$.error.Cause",
                  "ExecutionId.$": "$$.Execution.Id",
                  "StateMachineName.$": "$$.StateMachine.Name",
                  "StateMachineId.$": "$$.StateMachine.Id",
                  "ExecutionStartTime.$": "$$.Execution.StartTime",
                  "CallbackToken.$": "$$.Task.Token"
                }
              },
              "Next": "Fail"
            },
            "No Error": {
              "Type": "Succeed"
            },
            "Fail": {
              "Type": "Fail"
            }
          }
        },
        {
          "StartAt": "Run Publication Crawler",
          "States": {
            "Run Publication Crawler": {
              "Type": "Task",
              "Resource": "arn:aws:states:::aws-sdk:glue:startCrawler",
              "Parameters": {
                "Name": "${publication_crawler_name}"
              },
              "End": true
            }
          }
        },
        {
          "StartAt": "Run Validation Crawler",
          "States": {
            "Run Validation Crawler": {
              "Type": "Task",
              "Resource": "arn:aws:states:::aws-sdk:glue:startCrawler",
              "Parameters": {
                "Name": "${data_validation_reports_crawler_name}"
              },
              "End": true
            }
          }
        }
      ]
    }
  }
}
