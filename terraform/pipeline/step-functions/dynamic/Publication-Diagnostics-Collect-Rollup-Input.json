{
  "Comment": "THROWAWAY - manually-started diagnostics run for the 2201 publication clean memory comparison (variant: collect_rollup_input). Reads this branch's already-produced monthly_tracker_filled_posts_01_merge output and writes to a distinctly-named destination, never the real pipeline's. Delete once the comparison concludes.",
  "StartAt": "Run publication clean (collect_rollup_input) with diagnostics",
  "States": {
    "Run publication clean (collect_rollup_input) with diagnostics": {
      "Type": "Task",
      "Resource": "arn:aws:states:::ecs:runTask.sync",
      "Parameters": {
        "LaunchType": "FARGATE",
        "Cluster": "${polars_cluster_arn}",
        "TaskDefinition": "${publication_diagnostics_task_arn}",
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "Subnets": ${public_subnet_ids},
            "SecurityGroups": ["${publication_diagnostics_security_group_id}"],
            "AssignPublicIp": "ENABLED"
          }
        },
        "Overrides": {
          "ContainerOverrides": [
            {
              "Name": "publication-diagnostics-container",
              "Environment": [
                { "Name": "FIX_VARIANT", "Value": "collect_rollup_input" }
              ],
              "Command": [
                "_02_clean_prototype.py",
                "--merge_data_source",
                "${dataset_bucket_uri}/domain=99_publication/dataset=monthly_tracker_filled_posts_01_merge/",
                "--clean_destination",
                "${dataset_bucket_uri}/domain=99_publication/dataset=monthly_tracker_filled_posts_02_clean_diagnostics_collect_rollup_input/"
              ]
            }
          ]
        }
      },
      "End": true
    }
  }
}
