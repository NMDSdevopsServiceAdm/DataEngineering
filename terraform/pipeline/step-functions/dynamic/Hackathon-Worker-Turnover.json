{
  "Comment": "Manually-started. Filters the cleaned ASC-WDS worker data to permanent and temporary workers in the earliest file of each month since January 2020, then runs the crawler. Start with no execution input.",
  "StartAt": "Filter worker turnover data",
  "States": {
    "Filter worker turnover data": {
      "Type": "Task",
      "Resource": "arn:aws:states:::ecs:runTask.sync",
      "Parameters": {
        "LaunchType": "FARGATE",
        "Cluster": "${polars_cluster_arn}",
        "TaskDefinition": "${hackathon_task_arn}",
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "Subnets": ${public_subnet_ids},
            "SecurityGroups": ["${hackathon_security_group_id}"],
            "AssignPublicIp": "ENABLED"
          }
        },
        "Overrides": {
          "ContainerOverrides": [
            {
              "Name": "_98_hackathon-container",
              "Command": [
                "_01_worker_turnover.py",
                "--cleaned_ascwds_worker_source",
                "${dataset_bucket_uri}/domain=01_ascwds/dataset=worker_cleaned/",
                "--flagged_destination",
                "${dataset_bucket_uri}/domain=98_hackathon/dataset=worker_turnover_01_flagged/"
              ]
            }
          ]
        }
      },
      "Next": "Run hackathon crawler"
    },
    "Run hackathon crawler": {
      "Type": "Task",
      "Resource": "arn:aws:states:::states:startExecution.sync:2",
      "Parameters": {
        "StateMachineArn": "${run_crawler_state_machine_arn}",
        "Input": {
          "crawler_name": "${hackathon_crawler_name}",
          "AWS_STEP_FUNCTIONS_STARTED_BY_EXECUTION_ID.$": "$$.Execution.Id"
        }
      },
      "End": true
    }
  }
}
